{
  "manifest_version": 1,
  "app": {
    "id": "nas-backup-manager",
    "name": "Backup",
    "version": "0.1.18",
    "icon": "icon.svg",
    "category": "storage",
    "system": false
  },
  "run": {
    "exec": "bin/nas-backup-manager-axum",
    "socket": "/run/nas-os/apps/nas-backup-manager.sock",
    "background": true
  },
  "ui": {
    "protocol": 1
  },
  "provides": [],
  "permissions": {
    "paths": ["/srv/storage"],
    "packages": ["7zip"]
  }
}
